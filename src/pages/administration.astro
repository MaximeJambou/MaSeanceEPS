---
import Base from '../layouts/Base.astro';
import '../styles/admin.css';
import { lien } from '../lib/url.js';
---
<Base titre="Administration" nu={true}>
  <div class="adm">
    <div id="garde" class="adm-garde">Vérification de l'accès…</div>

    <div id="appli" hidden>
      <header class="adm-haut">
        <span class="adm-haut__marque"><i></i>Administration</span>
        <div class="adm-haut__droite">
          <span id="etat-publication" class="pastille pastille--attente" hidden></span>
          <span id="etat-depot" class="pastille">Dépôt : non connecté</span>
          <a class="b b--fin b--trait" style="border-color:rgba(255,255,255,.34);color:#fff" href={lien()} id="quitter">Quitter</a>
        </div>
      </header>

      <div class="adm-corps">
        <nav class="adm-flanc" aria-label="Sections">
          <span class="adm-flanc__titre">Contenu</span>
          <button type="button" class="adm-onglet" data-vue="tableau" aria-current="page">Tableau de bord</button>
          <button type="button" class="adm-onglet" data-vue="cycles">Cycles <b id="n-cycles"></b></button>
          <button type="button" class="adm-onglet" data-vue="seances">Séances <b id="n-seances"></b></button>
          <button type="button" class="adm-onglet" data-vue="exercices">Exercices <b id="n-exercices"></b></button>
          <button type="button" class="adm-onglet" data-vue="ressources">Ressources <b id="n-ressources"></b></button>
          <span class="adm-flanc__titre">Réglages</span>
          <button type="button" class="adm-onglet" data-vue="reglages">Clé, code et textes</button>
          <div class="adm-flanc__pied">
            <a id="lien-site" href={lien()} target="_blank" rel="noopener">Voir le site public ↗</a>
          </div>
        </nav>

        <main>
          <section class="adm-vue actif" id="vue-tableau"></section>
          <section class="adm-vue" id="vue-cycles"></section>
          <section class="adm-vue" id="vue-seances"></section>
          <section class="adm-vue" id="vue-exercices"></section>
          <section class="adm-vue" id="vue-ressources"></section>
          <section class="adm-vue" id="vue-reglages"></section>
        </main>
      </div>

      <div id="messages" class="adm-messages" aria-live="polite"></div>
    </div>
  </div>
</Base>

<script is:inline define:vars={{ racine: lien() }}>
  window.MSE_BASE = racine;
</script>
<script is:inline type="module" src={lien('admin/schema.js')}></script>
<script is:inline type="module" src={lien('admin/app.js')}></script>
