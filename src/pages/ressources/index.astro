---
import Base from '../../layouts/Base.astro';
import { ressources } from '../../lib/donnees.js';
import { lien } from '../../lib/url.js';
const categories = [...new Set(ressources.map((r) => r.categorie).filter(Boolean))];
---
<Base titre="Ressources" description="Documents à imprimer et articles pratiques." actif="ressources">
  <header class="panneau panneau--court">
    <div class="panneau__lueur"></div>
    <p class="eyebrow">À imprimer, à garder</p>
    <h1>Ressources</h1>
    <div class="metas"><span>{ressources.length} documents</span>{categories.map((c) => <span>{c}</span>)}</div>
  </header>
  <section class="section bande">
    <div class="dedans">
      <div class="grille grille--deux">
        {ressources.map((r) => (
          <article class="carte apparait">
            <div class="carte__haut">
              <span class="badge">{r.type || 'Document'}</span>
              {r.categorie && <span class="carte__sport" style="margin:0">{r.categorie}</span>}
            </div>
            <h3>{r.titre}</h3>
            <p>{r.description}</p>
            {r.fichier && (
              <div class="carte__pied">
                <a href={lien('documents/' + r.fichier)} style="color:var(--azur);font-family:var(--chrono);font-size:.74rem">Télécharger le PDF</a>
                <span class="carte__fleche" aria-hidden="true">↓</span>
              </div>
            )}
          </article>
        ))}
      </div>
      {ressources.length === 0 && <p class="vide">Aucune ressource publiée pour le moment.</p>}
    </div>
  </section>
</Base>
