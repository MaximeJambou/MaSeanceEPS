---
import Base from '../layouts/Base.astro';
import { lien } from '../lib/url.js';
---
<Base titre="Page introuvable">
  <header class="panneau">
    <div class="panneau__lueur"></div>
    <p class="eyebrow">Hors du terrain</p>
    <h1>Cette page n'existe pas</h1>
    <p style="color:rgba(255,255,255,.8);margin-top:20px;max-width:44ch">
      Le lien est peut-être ancien, ou la séance a changé de nom.
    </p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:30px">
      <a class="bouton bouton--or" href={lien('')}>Retour à l'accueil</a>
      <a class="bouton bouton--fantome" href={lien('seances/')}>Voir les séances</a>
    </div>
  </header>
</Base>
