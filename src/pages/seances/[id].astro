---
import Base from '../../layouts/Base.astro';
import Frise from '../../components/Frise.astro';
import SchemaTerrain from '../../components/SchemaTerrain.astro';
import { seances, cycleDe, seancesDuCycle, blocsDe, dureeReelle } from '../../lib/donnees.js';
import { lien } from '../../lib/url.js';

export function getStaticPaths() {
  return seances.map((s) => ({ params: { id: s.id }, props: { seance: s } }));
}

const { seance } = Astro.props;
const cycle = cycleDe(seance);
const soeurs = cycle ? seancesDuCycle(cycle.id) : [seance];
const blocs = blocsDe(seance);
const total = dureeReelle(seance);
const rang = String(seance.numero || 1).padStart(2, '0');
---

<Base titre={seance.titre} description={seance.objectif} actif="seances">
  <article>
    <header class="panneau">
      <div class="panneau__lueur"></div>
      <span class="panneau__num" aria-hidden="true">{rang}</span>
      <p class="eyebrow">
        {cycle && <a href={lien('cycles/' + cycle.id + '/')} style="color:inherit;text-decoration:underline">{cycle.sport} · {cycle.titre}</a>}
        {cycle && <> · Séance {seance.numero} sur {soeurs.length}</>}
      </p>
      <h1>{seance.titre}</h1>
      <div class="metas">
        <span>{total} minutes</span>
        {cycle && <span>{cycle.niveaux}</span>}
        {seance.lieu && <span>{seance.lieu}</span>}
        {cycle && <span>{cycle.periode}</span>}
      </div>
      {seance.objectif && (
        <div class="encart-objectif">
          <b>Objectif de la séance</b>
          {seance.objectif}
        </div>
      )}
    </header>

    <section class="section bande">
      <div class="dedans">
        <Frise seance={seance} />

        <div class="fiche">
          <div>
            {blocs.map((b) => {
              const ex = b.source || {};
              const estEx = b.genre === 'ex';
              return (
                <section class={'etape' + (estEx ? '' : ' etape--or')}>
                  <div class="etape__tete">
                    <span class="etape__duree">{b.duree}′</span>
                    <h3>{b.titre}</h3>
                    <span class="etape__role">
                      {b.genre === 'ech' ? 'Échauffement' : b.genre === 'ret' ? 'Retour au calme' : 'Exercice'}
                    </span>
                    <span class="etape__horaire">{b.debut}′ → {b.fin}′</span>
                  </div>

                  <p>{ex.description || ex.contenu}</p>

                  {estEx && ex.schema && <SchemaTerrain schema={ex.schema} titre={b.titre} />}

                  {(ex.organisation || ex.variable || ex.reussite) && (
                    <dl>
                      {ex.organisation && (<><dt>Organisation</dt><dd>{ex.organisation}</dd></>)}
                      {ex.variable && (<><dt>Variable</dt><dd>{ex.variable}</dd></>)}
                      {ex.reussite && (<><dt>Réussi si</dt><dd class="fort">{ex.reussite}</dd></>)}
                    </dl>
                  )}

                  {ex.observer && ex.observer.length > 0 && (
                    <div class="observation">
                      <h4>Ce qu'on regarde</h4>
                      <ul>{ex.observer.map((o) => <li>{o}</li>)}</ul>
                    </div>
                  )}

                  {ex.securite && (
                    <div class="securite"><b>Sécurité</b>{ex.securite}</div>
                  )}
                </section>
              );
            })}
          </div>

          <aside class="cote">
            {seance.critere && (
              <div class="cote__bloc cote__bloc--critere">
                <h4>Critère de réussite</h4>
                <p>{seance.critere}</p>
              </div>
            )}

            {seance.materiel && seance.materiel.length > 0 && (
              <div class="cote__bloc">
                <h4>Matériel à sortir</h4>
                <ul class="liste-materiel">{seance.materiel.map((m) => <li><span>{m}</span></li>)}</ul>
              </div>
            )}

            {soeurs.length > 1 && (
              <div class="cote__bloc">
                <h4>Le cycle, séance par séance</h4>
                <ul class="suite">
                  {soeurs.map((s) => (
                    <li aria-current={s.id === seance.id ? 'page' : undefined}>
                      <a href={lien('seances/' + s.id + '/')}>
                        <b>Séance {s.numero}</b>{s.titre}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <button class="bouton bouton--encre no-print" type="button" style="justify-content:center" onclick="window.print()">
              Imprimer la fiche
            </button>
          </aside>
        </div>
      </div>
    </section>
  </article>
</Base>
