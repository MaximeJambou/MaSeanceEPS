---
import Base from '../layouts/Base.astro';
import CarteCycle from '../components/CarteCycle.astro';
import { lien } from '../lib/url.js';
import { config, cycles, seances, ressources, seancesDuCycle, tousLesExercices } from '../lib/donnees.js';

const nbExercices = tousLesExercices().length;
const derniers = cycles.slice(0, 3);
const seanceVitrine = seances.find((s) => s.exercices?.length) || seances[0];
---
<Base titre="Accueil" description={config.sousTitre} actif="">
  <section class="heros">
    <div class="contenu heros__grille">
      <div class="pile" style="gap:22px">
        <span class="heros__surtitre">Éducation physique · cycle 2 &amp; cycle 3</span>
        <h1>{config.accroche}</h1>
        <p class="heros__texte">{config.sousTitre}</p>
        <div class="heros__actions">
          <a class="bouton bouton--or" href={lien('cycles/')}>
            Parcourir les cycles
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
          {seanceVitrine && (
            <a class="bouton heros__secondaire" href={lien(`seances/${seanceVitrine.id}/`)}>Voir une fiche séance</a>
          )}
        </div>
      </div>

      {seanceVitrine && (
        <div class="apercu">
          <div class="apercu__entete">
            <span class="surtitre">Séance {seanceVitrine.numero}</span>
            <span class="etiquette">{seanceVitrine.duree} min</span>
          </div>
          <h3 class="apercu__titre">{seanceVitrine.titre}</h3>
          <div class="pile" style="gap:10px">
            <div class="apercu__ligne"><span>{seanceVitrine.echauffement.duree}′</span><span>{seanceVitrine.echauffement.titre}</span></div>
            {seanceVitrine.exercices.map((ex) => (
              <div class="apercu__ligne"><span>{ex.duree}′</span><span>{ex.titre}</span></div>
            ))}
            <div class="apercu__ligne"><span>{seanceVitrine.retour.duree}′</span><span>Retour au calme</span></div>
          </div>
          <div class="encart-materiel" style="margin-top:16px">
            <div class="surtitre" style="color:var(--or-fonce)">Matériel</div>
            <div style="padding-top:4px">{seanceVitrine.materiel.join(' · ')}</div>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="chiffres">
    <div class="contenu chiffres__grille">
      <div><strong>{cycles.length}</strong><span>cycle{cycles.length > 1 ? 's' : ''} publié{cycles.length > 1 ? 's' : ''}</span></div>
      <div><strong>{seances.length}</strong><span>séances détaillées</span></div>
      <div><strong>{nbExercices}</strong><span>exercices décrits</span></div>
    </div>
  </section>

  <section class="contenu" style="padding-top:56px">
    <h2 class="surtitre">Activités couvertes</h2>
    <div class="puces">
      {config.sports.map((s) => <span class="puce">{s}</span>)}
    </div>
  </section>

  <section class="contenu" style="padding-top:56px">
    <div class="titre-section">
      <div class="pile" style="gap:8px">
        <h2>Les cycles les plus récents</h2>
        <p style="color:var(--gris)">Une progression complète, de la première séance à l'évaluation.</p>
      </div>
      <a href={lien('cycles/')} style="font-weight:600;white-space:nowrap">Tous les cycles →</a>
    </div>
    <div class="grille grille--3" style="padding-top:26px">
      {derniers.map((c) => <CarteCycle cycle={c} nbSeances={seancesDuCycle(c.id).length} />)}
    </div>
  </section>

  <section class="contenu" style="padding-top:64px">
    <div class="carte grille grille--3" style="padding:36px">
      <div class="pile" style="gap:10px">
        <span class="pastille-num">1</span>
        <h3 style="font-size:20px">Un cycle, une progression</h3>
        <p style="color:var(--gris)">Les séances s'enchaînent dans un ordre réfléchi, de la découverte à l'évaluation.</p>
      </div>
      <div class="pile" style="gap:10px">
        <span class="pastille-num">2</span>
        <h3 style="font-size:20px">Une séance, une fiche</h3>
        <p style="color:var(--gris)">Minutage, consignes, organisation du groupe, critère de réussite. Imprimable en une page.</p>
      </div>
      <div class="pile" style="gap:10px">
        <span class="pastille-num pastille-num--or">3</span>
        <h3 style="font-size:20px">Le matériel, annoncé</h3>
        <p style="color:var(--gris)">Ce qu'il faut sortir du local, listé séance par séance. Rien à improviser.</p>
      </div>
    </div>
  </section>

  <section class="contenu" style="padding-top:64px">
    <div class="titre-section">
      <h2>Ressources à télécharger</h2>
      <a href={lien('ressources/')} style="font-weight:600;white-space:nowrap">Toutes les ressources →</a>
    </div>
    <div class="grille grille--2" style="padding-top:24px">
      {ressources.slice(0, 2).map((r) => (
        <a class="carte ressource" href={lien('ressources/')}>
          <span class="ressource__icone">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5"></path>
            </svg>
          </span>
          <span class="pile" style="gap:3px">
            <strong style="font-size:18px">{r.titre}</strong>
            <span style="color:var(--gris);font-size:15px">{r.description}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .heros { background: var(--azur-fonce); color: #fff; position: relative; overflow: hidden; border-bottom: 6px solid var(--or); }
  .heros__grille { display: grid; grid-template-columns: 1fr 380px; gap: 56px; align-items: center; padding-block: 72px; }
  .heros__surtitre { font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--or); }
  .heros h1 { font-size: clamp(34px, 5vw, 58px); font-weight: 800; }
  .heros__texte { font-size: 19px; color: #C9DEF4; max-width: 520px; }
  .heros__actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .heros__secondaire { background: transparent; border: 1.5px solid rgba(255,255,255,.45); color: #fff; }
  .heros__secondaire:hover { background: rgba(255,255,255,.12); color: #fff; }

  .apercu { background: var(--blanc); color: var(--encre); border-radius: 16px; padding: 24px; box-shadow: 0 26px 60px rgba(3,26,50,.38); }
  .apercu__entete { display: flex; align-items: center; justify-content: space-between; padding-bottom: 12px; border-bottom: 1px solid var(--ligne); }
  .apercu__titre { font-size: 22px; font-weight: 700; padding: 14px 0 12px; }
  .apercu__ligne { display: flex; gap: 12px; align-items: baseline; font-size: 15px; }
  .apercu__ligne span:first-child { width: 40px; flex-shrink: 0; color: var(--gris); font-variant-numeric: tabular-nums; }

  .chiffres { background: var(--blanc); border-bottom: 1px solid var(--ligne); }
  .chiffres__grille { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 32px; padding-block: 36px; }
  .chiffres__grille div { display: flex; flex-direction: column; }
  .chiffres__grille div + div { border-left: 1px solid var(--ligne); padding-left: 32px; }
  .chiffres__grille strong { font-family: var(--titre); font-size: 42px; font-weight: 800; color: var(--azur); line-height: 1; }
  .chiffres__grille span { color: var(--gris); padding-top: 6px; }

  .puces { display: flex; flex-wrap: wrap; gap: 10px; padding-top: 16px; }
  .puce { background: var(--blanc); border: 1px solid var(--ligne); border-radius: 999px; padding: 9px 16px; font-size: 15px; font-weight: 500; }

  .titre-section { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .titre-section h2 { font-size: clamp(26px, 3.4vw, 36px); font-weight: 700; }

  .pastille-num { width: 40px; height: 40px; border-radius: 10px; background: var(--azur-clair); color: var(--azur-fonce); display: flex; align-items: center; justify-content: center; font-family: var(--titre); font-weight: 800; }
  .pastille-num--or { background: #FFF3D1; color: var(--or-fonce); }

  .ressource { display: flex; gap: 16px; align-items: center; color: inherit; }
  .ressource:hover { border-color: var(--azur); text-decoration: none; }
  .ressource__icone { width: 46px; height: 46px; flex-shrink: 0; border-radius: 10px; background: var(--azur-clair); color: var(--azur-fonce); display: flex; align-items: center; justify-content: center; }

  @media (max-width: 900px) {
    .heros__grille { grid-template-columns: 1fr; gap: 36px; padding-block: 48px; }
    .chiffres__grille { grid-template-columns: 1fr; gap: 18px; }
    .chiffres__grille div + div { border-left: 0; padding-left: 0; border-top: 1px solid var(--ligne); padding-top: 18px; }
  }
</style>
