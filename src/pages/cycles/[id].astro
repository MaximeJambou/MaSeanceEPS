---
import Base from '../../layouts/Base.astro';
import CarteSeance from '../../components/CarteSeance.astro';
import { cycles, seancesDuCycle, materielDuCycle, dureeReelle } from '../../lib/donnees.js';
import { pictoDe } from '../../lib/pictos.js';
import { lien } from '../../lib/url.js';

export function getStaticPaths() {
  return cycles.map((c) => ({ params: { id: c.id }, props: { cycle: c } }));
}
const { cycle } = Astro.props;
const liste = seancesDuCycle(cycle.id);
const materiel = materielDuCycle(cycle.id);
const minutes = liste.reduce((s, x) => s + dureeReelle(x), 0);
const { picto } = pictoDe(cycle.sport);
---
<Base titre={cycle.titre} description={cycle.resume} actif="cycles">
  <header class="panneau">
    <div class="panneau__lueur"></div>
    <p class="eyebrow">{cycle.sport} · {cycle.periode}</p>
    <h1>{cycle.titre}</h1>
    <div class="metas">
      <span>{cycle.niveaux}</span>
      <span>{liste.length} séance{liste.length > 1 ? 's' : ''}</span>
      <span>{minutes} minutes en tout</span>
    </div>
    {cycle.objectif && (<div class="encart-objectif"><b>Objectif du cycle</b>{cycle.objectif}</div>)}
  </header>

  <section class="section bande">
    <div class="dedans">
      <div class="fiche">
        <div>
          <div class="section__tete" style="margin-bottom:24px">
            <span class="eyebrow">Le déroulé</span>
            <h2 class="surtitre" style="font-size:clamp(1.4rem,2.8vw,2rem)">Les séances, dans l'ordre</h2>
          </div>
          <div class="grille grille--seances">
            {liste.map((s) => <CarteSeance seance={s} />)}
          </div>

          {cycle.remarque && (
            <div class="securite" style="margin-top:28px;background:var(--or-voile);border-color:var(--or)">
              <b style="color:var(--or-profond)">À savoir avant de lancer le cycle</b>{cycle.remarque}
            </div>
          )}
        </div>

        <aside class="cote">
          {cycle.apprentissages && cycle.apprentissages.length > 0 && (
            <div class="cote__bloc cote__bloc--critere">
              <h4>Ce que l'élève doit savoir faire</h4>
              <ul class="liste-materiel">{cycle.apprentissages.map((a) => <li><span>{a}</span></li>)}</ul>
            </div>
          )}
          {materiel.length > 0 && (
            <div class="cote__bloc">
              <h4>Matériel du cycle entier</h4>
              <ul class="liste-materiel">{materiel.map((m) => <li><span>{m}</span></li>)}</ul>
            </div>
          )}
          <div class="cote__bloc">
            <h4>Activité</h4>
            <div style="display:flex;align-items:center;gap:12px">
              <span class="carte__picto"><svg viewBox="0 0 64 68"><use href={'#' + picto} /></svg></span>
              <div><strong style="font-family:var(--titre)">{cycle.sport}</strong><br /><span style="font-family:var(--chrono);font-size:.72rem;color:var(--encre-pale)">{cycle.niveaux}</span></div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>
