---
import Base from '../../layouts/Base.astro';
import CarteCycle from '../../components/CarteCycle.astro';
import { cycles } from '../../lib/donnees.js';
const sports = [...new Set(cycles.map((c) => c.sport))];
---
<Base titre="Cycles" description="Tous les cycles publiés, filtrables par activité." actif="cycles">
  <header class="panneau panneau--court">
    <div class="panneau__lueur"></div>
    <p class="eyebrow">Les progressions</p>
    <h1>Cycles</h1>
    <p style="color:rgba(255,255,255,.8);margin-top:20px;max-width:54ch">
      Un cycle, c'est une suite de séances qui va quelque part. On y entre par une mesure, on en sort par la même.
    </p>
  </header>

  <section class="section bande">
    <div class="dedans">
      <div class="filtre-barre" role="group" aria-label="Filtrer par activité">
        <button type="button" data-sport="" aria-pressed="true">Toutes</button>
        {sports.map((s) => <button type="button" data-sport={s} aria-pressed="false">{s}</button>)}
      </div>
      <div class="grille grille--cycles" id="liste">
        {cycles.map((c) => <div data-sport={c.sport} class="apparait"><CarteCycle cycle={c} /></div>)}
      </div>
      <p class="vide" id="vide" hidden>Aucun cycle pour cette activité.</p>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    var items = [].slice.call(document.querySelectorAll('#liste > [data-sport]'));
    var boutons = [].slice.call(document.querySelectorAll('.filtre-barre button'));
    var vide = document.getElementById('vide');
    boutons.forEach(function (b) {
      b.addEventListener('click', function () {
        boutons.forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
        var n = 0;
        items.forEach(function (i) {
          var ok = !b.dataset.sport || i.dataset.sport === b.dataset.sport;
          i.hidden = !ok; if (ok) n++;
        });
        vide.hidden = n > 0;
      });
    });
  })();
</script>
