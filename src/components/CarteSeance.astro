---
import { lien } from '../lib/url.js';
import { pictoDe } from '../lib/pictos.js';
import { cycleDe, dureeReelle } from '../lib/donnees.js';
const { seance } = Astro.props;
const cycle = cycleDe(seance);
const { teinte } = pictoDe(cycle ? cycle.sport : '');
const nbEx = (seance.exercices || []).length;
const total = dureeReelle(seance);
---
<a class={'carte ' + teinte} href={lien('seances/' + seance.id + '/')}>
  <div class="carte__haut">
    <span class="carte__num">{String(seance.numero || 1).padStart(2, '0')}</span>
    <span class="badge">{total}′</span>
  </div>
  <span class="carte__sport">{cycle ? cycle.sport : 'Séance'}</span>
  <h3>{seance.titre}</h3>
  <p>{seance.objectif}</p>
  <div class="carte__pied">
    <strong>{nbEx} exercice{nbEx > 1 ? 's' : ''}</strong> · {seance.lieu}
    <span class="carte__fleche" aria-hidden="true">→</span>
  </div>
</a>
