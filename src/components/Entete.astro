---
import { lien } from '../lib/url.js';
const { actif = '' } = Astro.props;
const liens = [
  { cle: 'accueil',    texte: 'Accueil',    href: lien('') },
  { cle: 'cycles',     texte: 'Cycles',     href: lien('cycles/') },
  { cle: 'seances',    texte: 'Séances',    href: lien('seances/') },
  { cle: 'exercices',  texte: 'Exercices',  href: lien('exercices/') },
  { cle: 'ressources', texte: 'Ressources', href: lien('ressources/') },
  { cle: 'a-propos',   texte: 'La démarche', href: lien('a-propos/') },
];
---
<header class="barre">
  <div class="barre__pilule">
    <a class="marque-mot" href={lien('')}><i></i>MaSéanceEPS</a>
    <button class="barre__menu" type="button" aria-expanded="false" aria-controls="menu-principal" aria-label="Ouvrir le menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <nav class="barre__liens" id="menu-principal">
      {liens.map((l) => (
        <a href={l.href} aria-current={actif === l.cle ? 'page' : undefined}>{l.texte}</a>
      ))}
    </nav>
    <a class="barre__cta" href={lien('seances/')}>Trouver une séance</a>
  </div>
</header>
