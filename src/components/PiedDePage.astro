---
import { lien } from '../lib/url.js';
import { config, cycles } from '../lib/donnees.js';
const activites = [...new Set(cycles.map((c) => c.sport))].slice(0, 5);
---
<footer class="pied bande">
  <div class="dedans">
    <p class="pied__mot">MaSéance<i>EPS</i></p>

    <div class="pied__grille">
      <nav>
        <span class="eyebrow">Le site</span>
        <a href={lien('cycles/')}>Cycles</a>
        <a href={lien('seances/')}>Séances</a>
        <a href={lien('exercices/')}>Exercices</a>
        <a href={lien('ressources/')}>Ressources</a>
      </nav>
      <nav>
        <span class="eyebrow">Activités</span>
        {activites.map((a) => <a href={lien('cycles/')}>{a}</a>)}
      </nav>
      <nav style="max-width:34ch">
        <span class="eyebrow">La démarche</span>
        <p style="font-size:.92rem;color:rgba(255,255,255,.6);margin:0">
          Des séances partagées librement, sans compte et sans nom. Aucune donnée d'élève n'est publiée ici.
        </p>
        <a href={lien('a-propos/')} style="margin-top:10px">En savoir plus →</a>
      </nav>
    </div>

    <div class="pied__bas">
      <span>Consultation libre · {config.titre}</span>
      <button class="bouee" id="acces" type="button" aria-label="Espace de gestion" aria-haspopup="dialog">
        <svg viewBox="0 0 64 64" width="34" height="34"><use href="#p-bouee" /></svg>
      </button>
    </div>
  </div>
</footer>

<div class="tiroir" id="tiroir" role="dialog" aria-modal="true" aria-labelledby="tiroir-titre" hidden>
  <button class="fermer" type="button" id="tiroir-fermer" aria-label="Fermer">×</button>
  <h2 id="tiroir-titre">Espace de gestion</h2>
  <p style="color:rgba(255,255,255,.68);font-size:.94rem;margin:0">Réservé à la personne qui alimente le site.</p>
  <form id="tiroir-form" style="display:flex;flex-direction:column;gap:14px;margin-top:6px">
    <input type="password" id="tiroir-code" placeholder="Code d'accès" autocomplete="off" aria-label="Code d'accès" />
    <button class="bouton bouton--or" type="submit" style="justify-content:center">Se connecter</button>
  </form>
</div>

<script define:vars={{ empreinte: config.admin.empreinte, sel: config.admin.sel, urlAdmin: lien('administration/') }}>
  (function () {
    var bouee = document.getElementById('acces');
    var tiroir = document.getElementById('tiroir');
    var champ = document.getElementById('tiroir-code');
    if (!bouee || !tiroir) return;

    function ouvrir() {
      tiroir.hidden = false;
      requestAnimationFrame(function () { tiroir.classList.add('ouvert'); champ.focus(); });
    }
    function fermer() {
      tiroir.classList.remove('ouvert');
      champ.value = '';
      setTimeout(function () { tiroir.hidden = true; }, 260);
    }
    bouee.addEventListener('click', ouvrir);
    document.getElementById('tiroir-fermer').addEventListener('click', fermer);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !tiroir.hidden) fermer(); });

    document.getElementById('tiroir-form').addEventListener('submit', async function (e) {
      e.preventDefault();
      var octets = new TextEncoder().encode(sel + champ.value);
      var resume = await crypto.subtle.digest('SHA-256', octets);
      var hexa = Array.from(new Uint8Array(resume)).map(function (o) { return o.toString(16).padStart(2, '0'); }).join('');
      if (hexa === empreinte) {
        sessionStorage.setItem('mse-acces', empreinte);
        window.location.href = urlAdmin;
      } else {
        fermer();
      }
    });
  })();
</script>
