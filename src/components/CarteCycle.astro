---
import { lien } from '../lib/url.js';
import { pictoDe } from '../lib/pictos.js';
import { seancesDuCycle } from '../lib/donnees.js';
const { cycle } = Astro.props;
const { picto, teinte } = pictoDe(cycle.sport);
const nb = seancesDuCycle(cycle.id).length;
---
<a class={'carte ' + teinte} href={lien('cycles/' + cycle.id + '/')}>
  <div class="carte__haut">
    <span class="carte__picto"><svg viewBox="0 0 64 68"><use href={'#' + picto} /></svg></span>
    <span class="badge">{cycle.niveaux}</span>
  </div>
  <span class="carte__sport">{cycle.sport}</span>
  <h3>{cycle.titre}</h3>
  <p>{cycle.resume}</p>
  <div class="carte__pied">
    <strong>{nb} séance{nb > 1 ? 's' : ''}</strong> · {cycle.duree}′ · {cycle.periode}
    <span class="carte__fleche" aria-hidden="true">→</span>
  </div>
</a>
