---
/*
  Schéma de terrain.
  Le dessin est produit par public/admin/schema.js, le même fichier que celui
  qu'utilise l'aperçu en direct de l'administration : les deux ne peuvent pas
  diverger. Ce composant ne fait que l'appeler.
*/
import { figureSchema } from '../../public/admin/schema.js';

const { schema } = Astro.props;
const html = schema ? figureSchema(schema, 'sch' + Math.random().toString(36).slice(2, 8)) : '';
---
{html && <Fragment set:html={html} />}
